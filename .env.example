# Required: at least one API key (comma separated). Generate with: openssl rand -hex 24
IDCARD_API_KEYS=change-me

# Encrypted image retention. Generate a key with: idcard-ocr gen-key
# Several keys may be listed: the first encrypts, all of them decrypt (rotation).
IDCARD_STORE_KEYS=

# Retention in days; run `idcard-ocr purge` from cron to enforce it.
IDCARD_RETENTION_DAYS=30

# Resource tuning for small CPU-only hosts.
IDCARD_MAX_CONCURRENCY=2
IDCARD_MAX_UPLOAD_BYTES=8388608
